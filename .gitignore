# =====================================================================
# Droidoom — .gitignore
# =====================================================================

# ---------------------------------------------------------------------
# 1. PRIVATE PROJECT DOCS — plans, business model, progress reports
#    These stay on the local machine only (AI agents still read them
#    locally). Back them up separately — git will NOT version them.
# ---------------------------------------------------------------------
/projectdetails.md
/docs/*
# ...except files that are safe/necessary to share:
!/docs/ASSET_LICENSES.md

# Any stray plan / progress / report files elsewhere in the repo
**/PROGRESS*.md
**/SESSION_LOG*.md
**/DECISIONS*.md
**/TASKS*.md
**/*.plan.md
**/*_PLAN.md
**/*_REPORT.md
/notes/
/private/

# ---------------------------------------------------------------------
# 2. ENVIRONMENT FILES & SECRETS
# ---------------------------------------------------------------------
.env
.env.*
*.env
!.env.example
!**/.env.example
secrets/
**/secrets.*
*.secret
*.secrets

# Signing keys & certificates (Android / iOS / macOS / Windows)
*.keystore
*.jks
!debug.keystore.example
*.p12
*.pfx
*.pem
*.key
*.cer
*.crt
*.csr
*.mobileprovision
*.provisionprofile
*.certSigningRequest
keystore.properties
google-services.json
GoogleService-Info.plist
service-account*.json
**/play-store-credentials*.json
AuthKey_*.p8

# Steam (dev-only app id file, partner SDK which must not be redistributed)
steam_appid.txt
steamworks_sdk*/
**/steamworks/sdk/

# Store / ad / analytics keys if ever kept in files
**/admob_ids*.json
**/api_keys*.*

# ---------------------------------------------------------------------
# 3. GODOT 4
# ---------------------------------------------------------------------
.godot/
.import/
*.translation
*.uid.tmp
# Godot 4 keeps export passwords in .godot/export_credentials.cfg (ignored above).
# export_presets.cfg is safe to commit — never put secrets in it by hand.
mono_crash.*.json
# C# (not used, guard anyway)
.mono/
data_*/

# Godot Android build template (regenerated by the editor)
game/android/build/
game/android/.build_version

# ---------------------------------------------------------------------
# 4. BUILD OUTPUT & EXPORTS
# ---------------------------------------------------------------------
/build/
/builds/
/export/
/exports/
/dist/
*.pck
*.apk
*.aab
*.ipa
*.exe
*.dmg
*.app/
*.x86_64
*.zip
!tools/**/*.zip
*.xcarchive

# ---------------------------------------------------------------------
# 5. BACKEND (Nakama server modules — TypeScript)
# ---------------------------------------------------------------------
server/node_modules/
server/build/
server/dist/
server/data/
server/**/*.log
server/docker-volumes/

# Node (any tooling)
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------
# 6. PYTHON TOOLING (gdtoolkit etc.)
# ---------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# ---------------------------------------------------------------------
# 7. ART / AUDIO WORK FILES (keep exported assets, not scratch/backups)
# ---------------------------------------------------------------------
*.kra~
*.blend1
*.blend2
*.psd~
*~autosave*
*.aseprite.bak
/art_wip/
/audio_wip/

# ---------------------------------------------------------------------
# 8. TEST, PROFILING & CRASH OUTPUT
# ---------------------------------------------------------------------
/reports/
/coverage/
game/tests/results/
*.log
*.profile
*.dmp
sentry-*.txt

# ---------------------------------------------------------------------
# 9. EDITORS, IDEs & AI-AGENT LOCAL SETTINGS
# ---------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.code-workspace
.claude/settings.local.json
.claude/*.local.*
CLAUDE.local.md

# ---------------------------------------------------------------------
# 10. OS JUNK
# ---------------------------------------------------------------------
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.tmp
*.bak
