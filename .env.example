# Copy to .env and fill in locally. NEVER commit .env (it is git-ignored).
# Every variable the project uses must be listed here with an empty or dummy value.

# --- Godot binary (optional override; default uses the `godot_console` alias) ---
GODOT_BIN=

# --- Web deploy (Phase 3+) ---
ITCH_USER=
ITCH_GAME=
BUTLER_API_KEY=

# --- Android signing (Phase 5) ---
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_USER=
ANDROID_KEYSTORE_PASSWORD=

# --- Backend (Phase 5, optional) ---
NAKAMA_HOST=
NAKAMA_SERVER_KEY=

# --- Crash reporting (Phase 4) ---
SENTRY_DSN=
